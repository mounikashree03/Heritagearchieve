# ==============================================================================
# HeritageArchive Backend Configuration Template
# Copy this file to '.env' and adjust credentials for your local MySQL / XAMPP setup.
# ==============================================================================

# Server Port
PORT=5000

# Client Origin for CORS (e.g. Vite frontend)
CLIENT_ORIGIN=http://localhost:5173

# MySQL Database Connection Settings (XAMPP / MariaDB defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=historical_artifact_db
DB_USER=root
DB_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
